{
  "$schema": "https://opencode.ai/config.json",

  // Разрешения проекта. Правила утверждены владельцем репозитория.
  // НЕ ИЗМЕНЯТЬ и НЕ ДОБАВЛЯТЬ правила без отдельного указания владельца.
  // Порядок важен: последнее совпадение побеждает.

  "permissions": [
    // 1. git commit — выполняется без подтверждения
    { "action": "shell", "resource": "git commit*", "effect": "allow" },

    // 2. git push — только после подтверждения в диалоге.
    //    Перед запросом подтверждения агент обязан показать: текущую ветку,
    //    remote, отправляемые коммиты, git diff --stat, и что push НЕ force.
    { "action": "shell", "resource": "git push *", "effect": "ask" },

    // 3. Полный запрет. Идёт после правила «ask» (последнее совпадение побеждает),
    //    поэтому force-варианты push и reset --hard блокируются всегда.
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push --force-with-lease*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },

    // 4. Удаление файлов БД (*.db, *.db-wal, *.db-shm) — с подтверждением
    { "action": "shell", "resource": "rm *.db*", "effect": "ask" },
    { "action": "shell", "resource": "rm *.db-*", "effect": "ask" },

    // 5. Редактирование .env и .env.* запрещено (действует на edit/write/patch)
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },

    // 6. .env.example разрешён. Должен идти ПОСЛЕ deny-правил выше,
    //    иначе его перехватит "*.env.* → deny".
    { "action": "edit", "resource": "*.env.example", "effect": "allow" }
  ]
}
