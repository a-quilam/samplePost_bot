# Скопируйте этот файл в .env и заполните значения.
# Файл .env содержит секреты и не должен попадать в git.

# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# ID чата/канала для отправки постов на согласование.
# Отрицательное число для групп/каналов, например: -1001234567890.
# Если не заполнен, отправка на согласование отключается (бот не падает).
REVIEW_CHAT_ID=

# ID чата/канала для публикации согласованных постов.
# Отрицательное число для групп/каналов, например: -1001234567890.
# Если не заполнен, кнопка «Опубликовать» сообщит, что публикация не настроена.
PUBLICATION_CHAT_ID=

# Telegram ID администраторов через запятую (обязательно), например: 123456789,987654321
ADMIN_IDS=
