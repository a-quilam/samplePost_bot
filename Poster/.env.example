# Скопируйте этот файл в .env и заполните значения.
# Файл .env содержит секреты и не должен попадать в git.

# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# (Опционально) Строка подключения к SQLite.
# По умолчанию: sqlite:///./post_bot.db (файл в каталоге запуска).
# В Docker compose путь подставляется автоматически: sqlite:////app/data/post_bot.db
DATABASE_URL=

# (Опционально) Уровень логирования: DEBUG, INFO, WARNING, ERROR.
# По умолчанию INFO. Файл логов: logs/bot.log (ротация 5 МБ × 5 копий).
LOG_LEVEL=
