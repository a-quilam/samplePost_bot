# Скопируйте этот файл в .env и заполните значения.
# Файл .env содержит секреты и не должен попадать в git.

# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# (Опционально) Строка подключения к SQLite.
# По умолчанию: файл post_bot.db в каталоге Poster/ (путь привязан к
# каталогу проекта, а не к каталогу запуска).
# В Docker compose путь подставляется автоматически: sqlite:////app/data/post_bot.db
DATABASE_URL=

# (Опционально) Уровень логирования: DEBUG, INFO, WARNING, ERROR.
# По умолчанию INFO. Файл логов: Poster/logs/bot.log (путь привязан к
# каталогу проекта; ротация 5 МБ × 5 копий; токен из логов вычищается).
LOG_LEVEL=

# (Опционально) Постоянные Telegram user ID суперадминистраторов через запятую.
# Только числа, без @username. Пустое значение = административные функции
# закрыты; обычные пользовательские сценарии продолжают работать.
# Пример формата: 100000001,100000002 (замените на реальные ID владельца).
SUPERADMIN_USER_IDS=

# (Опционально) Абсолютная http(s)-ссылка на контакт суперадминистратора для
# кнопки «Я админ места». Если пусто — бот сообщит, что контакт не указан.
# Не вписывайте сюда вымышленный или чужой профиль.
SUPERADMIN_CONTACT_URL=
